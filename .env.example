# ==========================================
# AdaptiveDocAI Configuration
# ==========================================

# Environment & Server
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="AdaptiveDocAI"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY="change_me_to_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=adaptivedoc
POSTGRES_PASSWORD=adaptivedoc_secret
POSTGRES_DB=adaptivedoc_db
# For production PostgreSQL: postgresql+asyncpg://adaptivedoc:adaptivedoc_secret@localhost:5432/adaptivedoc_db
# For local lightweight dev/testing fallback: sqlite+aiosqlite:///./adaptivedoc.db
DATABASE_URL=postgresql+asyncpg://adaptivedoc:adaptivedoc_secret@localhost:5432/adaptivedoc_db

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=adaptive_doc_nodes
# QDRANT_API_KEY=

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Object Storage (MinIO / S3)
STORAGE_BACKEND=local # options: local, s3
LOCAL_STORAGE_DIR="./data/storage"
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=adaptivedoc-assets
S3_REGION=us-east-1

# AI Models & Providers
DEFAULT_LLM_PROVIDER=openai # options: openai, gemini, anthropic, ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embedding & Reranking Models
DENSE_EMBEDDING_MODEL="BAAI/bge-large-en-v1.5"
RERANKER_MODEL="BAAI/bge-reranker-large"
NLI_VERIFIER_MODEL="cross-encoder/nli-deberta-v3-small"

# Research & Adaptive Thresholds
DEFAULT_TAU_ANSWER=0.35
DEFAULT_TAU_ABSTAIN=0.65
MAX_RETRIEVAL_HOPS=2

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
